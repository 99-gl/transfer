# Neo4j is required by the import and query APIs.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# These values are not required for Excel synchronization or keyword search.
# Set them before enabling Graphiti semantic retrieval or LLM extraction.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=qwen2.5
LOCAL_LLM_API_KEY=dummy-key
LOCAL_EMBED_BASE_URL=http://localhost:8001/v1
LOCAL_EMBED_MODEL=BAAI/bge-m3
LOCAL_EMBED_API_KEY=dummy-key
